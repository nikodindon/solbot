# ──────────────────────────────────────────────────────────────
# solbot — exemple de configuration d'environnement
# Le fichier réel (.env) est généré par `npm run solbot -- init`.
# Ne committez JAMAIS un fichier .env réel.
# ──────────────────────────────────────────────────────────────

# Wallet de trading (généré par `npm run solbot -- init`)
# Clé privée de 64 octets encodée base58 — format compatible Phantom.
BS58_PRIVATE_KEY=

# Clé API Jupiter — https://developers.jup.ag/portal
# Sans clé : accès "keyless" limité à 0.5 requête/s.
JUPITER_API_KEY=

# Débit max d'appels API Jupiter (requêtes/seconde). Vide = automatique :
# 1 RPS avec clé API, 0.5 RPS sans. Adaptez à votre tier :
# Free 1 · Developer 10 · Launch 50 · Pro 150.
JUPITER_RPS=

# RPC Solana (lecture des soldes ; le path Swap V2 /order + /execute est RPC-less)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# RPC de secours optionnel (utilisé si le principal est injoignable)
SOLANA_RPC_URL_FALLBACK=

# Notifications Telegram (optionnel — Phase 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Niveau de log : trace | debug | info | warn | error | fatal
LOG_LEVEL=info
