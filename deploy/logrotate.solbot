# solbot — rotation des logs fichier (Phase 5)
#
# Le mode par défaut écrit sur stdout : sous systemd, journald gère la rotation ;
# sous Docker, le driver json-file (cf. docker-compose.yml) la limite.
# Ce fichier ne sert que si vous redirigez les logs vers des fichiers, ex. :
#   ExecStart=... sh -c 'node dist/index.js start >> /var/log/solbot/solbot.log 2>&1'
#
# Installation : sudo cp deploy/logrotate.solbot /etc/logrotate.d/solbot
/var/log/solbot/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
